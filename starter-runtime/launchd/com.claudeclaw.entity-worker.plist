<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claudeclaw.entity-worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string><USER_HOME>/claudeclaw/scripts/entity-extraction-worker.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string><USER_HOME>/claudeclaw</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string><USER_HOME></string>
  </dict>
  <key>StartInterval</key>
  <integer>180</integer>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string><USER_HOME>/claudeclaw/logs/entity-worker.stdout.log</string>
  <key>StandardErrorPath</key>
  <string><USER_HOME>/claudeclaw/logs/entity-worker.stderr.log</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
