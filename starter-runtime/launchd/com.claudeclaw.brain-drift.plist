<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claudeclaw.brain-drift</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string><USER_HOME>/claudeclaw/scripts/run-brain-drift-check.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string><USER_HOME>/claudeclaw</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string><USER_HOME></string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string><USER_HOME>/claudeclaw/logs/brain-drift.stdout.log</string>
  <key>StandardErrorPath</key>
  <string><USER_HOME>/claudeclaw/logs/brain-drift.stderr.log</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
