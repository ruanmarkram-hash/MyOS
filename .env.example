# ClaudeClaw environment variables
# Copy this file to ~/claudeclaw/.env and fill in the values.
# The intake-and-setup skill walks you through collecting every one.
# Permissions: chmod 600 ~/claudeclaw/.env  (only you can read it)

# ── Supabase (brain storage) ────────────────────────────────────────
# Phase 5 of the intake skill walks you through creating these.

OB1_SUPABASE_URL=https://<project-ref>.supabase.co
OB1_SUPABASE_ANON_KEY=eyJ...
OB1_SUPABASE_SERVICE_KEY=eyJ...
OB1_SUPABASE_DB_URL=postgresql://postgres.<ref>:<password>@aws-...

# ── Gemini (AI model for thinking + embedding) ──────────────────────
# Phase 6 walks you through getting this from Google AI Studio.

GOOGLE_API_KEY=AIza...

# ── Brain MCP ───────────────────────────────────────────────────────
# Auto-generated in Phase 8. A 64-character hex secret.

MCP_ACCESS_KEY=<64 hex characters>
OB1_BRAIN_FUNCTION=brain-mcp

# Backend selector: ob1 uses OpenBrain, sqlite is the local fallback.
# Leave as ob1 unless you have a reason.
BRAIN=ob1

# ── Telegram (optional, for phone access) ───────────────────────────
# Phase 7 walks you through creating these if you chose Telegram access.
# Skip these if you're Claude-Code-only.

TELEGRAM_BOT_TOKEN=<bot token from BotFather>
ALLOWED_CHAT_ID=<your numeric chat ID>

# ── Optional extras ─────────────────────────────────────────────────
# Leave these blank until you know you need them.

# ANTHROPIC_API_KEY=       # only if you want Haiku fallback for memory extraction
# GROQ_API_KEY=            # only for voice transcription
# ELEVENLABS_API_KEY=      # only for TTS
# SLACK_USER_TOKEN=        # only if you want Slack integration
# SENTRY_AUTH_TOKEN=       # only if you want Sentry error tracking

# ── Runtime ─────────────────────────────────────────────────────────
# Safe defaults; don't change unless you know why.

AGENT_TIMEOUT_MS=900000
AGENT_MAX_TURNS=30
CONTEXT_LIMIT=1000000
STREAM_STRATEGY=off
SHOW_COST_FOOTER=compact
