# Dependencies
node_modules/

# Build output
dist/

# Per-mission git worktrees (mission-worktree.ts). Created/destroyed
# automatically by the Mason scheduler — never commit them.
.worktrees/

# Environment — never commit API keys
.env

# Runtime data — NEVER commit. Contains WhatsApp/Slack messages,
# session tokens, conversation logs, and database files.
store/
workspace/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Migration state — local only
migrations/.applied.json

# Logs
*.log
/tmp/myos.*

# Python
__pycache__/
*.pyc
.venv/
warroom/.venv/

# Generated outputs — personal diagrams, not for sharing
outputs/
models/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
.wwebjs_cache/

# Personal scripts — not for sharing
scripts/waste-reminder.sh
start-main.sh
WARROOM_TEST_PLAN.md

