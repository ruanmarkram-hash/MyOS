# Dependencies
node_modules/

# Build output
dist/

# Per-mission git worktrees (mission-worktree.ts). Created/destroyed
# automatically by the Mason scheduler — never commit them.
.worktrees/

# Environment — never commit API keys
.env

# Runtime data — NEVER commit. Contains WhatsApp/Slack messages,
# session tokens, conversation logs, and database files.
store/
workspace/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Migration state — local only
migrations/.applied.json

# Logs
*.log
/tmp/claudeclaw.*

# Python
__pycache__/
*.pyc
.venv/
warroom/.venv/

# Generated outputs — personal diagrams, not for sharing
outputs/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
.wwebjs_cache/

# Personal scripts — not for sharing
scripts/waste-reminder.sh
start-main.sh
WARROOM_TEST_PLAN.md

# War Room dev/test artifacts
warroom/test-audio*.wav
warroom/test_harness.py
warroom/TEST_REPORT.md
warroom/music.mp3
warroom/avatars/backup-*/
warroom/avatars/photoreal-backup/

# Personal config — lives in CLAUDECLAW_CONFIG (default ~/.claudeclaw)
CLAUDE.md
agents/*/agent.yaml
agents/*/CLAUDE.md

# Recipe-local creds — never commit
vendor/ob1/**/.env.local
vendor/**/.env.local

# Symlinked agent dirs live in ~/workspace/operations/engine-room/agents/
# Don't track files at these symlinked paths — they're managed in workspace.
agents/_template/
